# Supabase — project URL and the publishable (anon) key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Server-only. Bypasses Row Level Security — never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Gemini
GOOGLE_API_KEY=<google-api-key>

# Set to "true" only after configuring the Google provider in
# Supabase → Authentication → Providers. Until then the button stays hidden
# rather than showing a control that errors.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# The signed-out preview (1 document, 3 questions) rides on Supabase anonymous
# sign-ins, so a trial visitor gets a real auth.uid() and RLS still applies.
# Set to "true" only after enabling "Anonymous sign-ins" in
# Supabase → Authentication → Providers. Until then the Try-it button stays
# hidden and visitors are pointed at sign-up instead.
NEXT_PUBLIC_ENABLE_ANON_TRIAL=false
