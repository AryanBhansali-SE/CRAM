# ---------------------------------------------------------------------------
# Required — the app will not work without these.
# ---------------------------------------------------------------------------

# Supabase — project URL and the publishable (anon) key are safe in the browser.
# Every request made with the anon key is still subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Gemini, for embeddings and answers. Server-only.
GOOGLE_API_KEY=<google-api-key>

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# The canonical public URL, no trailing slash (e.g. https://cram.app).
#
# Confirmation emails and the OAuth callback are built from this, and the result
# must exactly match a URL allowlisted under Supabase → Authentication → URL
# Configuration. Without it the app falls back to the request's Origin header,
# which on a preview deployment is a hostname Supabase will refuse.
NEXT_PUBLIC_SITE_URL=https://<your-domain>

# Server-only. Bypasses Row Level Security — never expose this to the client.
#
# Required in production now that the Whop webhook exists: profiles has
# select-only RLS so a user can't grant themselves is_paid, which means the
# only thing that can write that column is a client which bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Whop webhook signing secret, from Whop → Developer → Webhooks. It looks like
# ws_0123... — store it exactly as Whop gives it to you, prefix included.
#
# Without this the webhook endpoint rejects every request, which is deliberate:
# unverified requests are how someone grants themselves a paid account.
WHOP_WEBHOOK_SECRET=ws_<webhook-signing-secret>

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Set to "true" only after configuring the Google provider in
# Supabase → Authentication → Providers. Until then the button stays hidden
# rather than showing a control that errors.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# The signed-out preview (1 document, 3 questions) rides on Supabase anonymous
# sign-ins, so a trial visitor gets a real auth.uid() and RLS still applies.
# Set to "true" only after enabling "Anonymous sign-ins" in
# Supabase → Authentication → Providers. Until then the Try-it button stays
# hidden and visitors are pointed at sign-up instead.
NEXT_PUBLIC_ENABLE_ANON_TRIAL=false

# ---------------------------------------------------------------------------
# Set automatically by Vercel — do not configure these yourself.
#
#   VERCEL_PROJECT_PRODUCTION_URL  stable production hostname, used as the
#                                  fallback when NEXT_PUBLIC_SITE_URL is unset.
# ---------------------------------------------------------------------------
